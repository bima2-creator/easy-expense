{
  "expo": {
    "name": "Finance Bitech",
    "slug": "finance-bitech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financebitech",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.co.bitech.financeapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan receipts to track your expenses",
        "NSPhotoLibraryUsageDescription": "Upload receipt photos to track expenses"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "id.co.bitech.financeapp",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan receipts to track your expenses"
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Easy Expense butuh akses kamera untuk memindai struk secara otomatis"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload receipt photos to track expenses"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}