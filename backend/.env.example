# MongoDB connection string.
# - Lokal: mongodb://localhost:27017
# - Cloud (gratis): buat cluster di MongoDB Atlas, lalu pakai connection string dari sana
#   contoh: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Nama database yang dipakai
DB_NAME=easy_expense

# API key gratis dari OCR.space untuk baca teks struk (tanpa kartu kredit, tanpa biaya)
# Daftar & ambil key gratis di: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your_free_ocr_space_key
